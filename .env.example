# Copy to .env and fill in.
# From https://developer.spotify.com/dashboard (app with Web API enabled)
SPOTIFY_CLIENT_ID=
# Must match a redirect URI registered on your Spotify app exactly.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Optional: auto | transformer | lexicon
VIBECHECK_EMOTION_BACKEND=auto
